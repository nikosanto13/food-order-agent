# --- LLM ---
MISTRAL_API_KEY=your-key-here
# MISTRAL_MODEL=mistral-small-latest

# --- MCP order server ---
# Local mock (default). Start it with `make mock-server` or run `python main.py --local`.
MCP_URL=http://127.0.0.1:8765/mcp
# Production server:
# MCP_URL=https://webviews.moveo.ai/api/demo/mcp
APPLICANT_EMAIL=you@example.com

# --- Voice (optional): `uv sync --extra voice`, then `python main.py --voice` ---
# ELEVENLABS_API_KEY=your-key-here
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# ELEVENLABS_STT_MODEL=scribe_v2
# VOICE_STT_KEYTERMS=true
# VOICE_END_SILENCE_MS=900     # pause that ends your turn
# VOICE_VAD_MARGIN_DB=12       # raise in a noisy room

# --- Observability ---
# LOG_LEVEL=INFO
# LOG_DIR=logs
